{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aqua:deployment-authorization-attestation:v2",
  "title": "Aqua deployment authorization attestation v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "attestationId", "issuer", "verifier", "audience", "source", "policy", "issuedAt", "expiresAt", "mandatoryChecks", "tests", "executionEvidenceSha256", "verdict"],
  "properties": {
    "contract": {"const": "aqua.deployment.authorization-attestation"},
    "version": {"const": 2},
    "attestationId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "issuer": {
      "type": "object", "additionalProperties": false, "required": ["identity", "keyId"],
      "properties": {"identity": {"type": "string", "minLength": 1}, "keyId": {"type": "string", "minLength": 1}}
    },
    "verifier": {
      "type": "object", "additionalProperties": false, "required": ["identity", "repository", "workflow", "revision"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "workflow": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "audience": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["repository", "commitSha", "ciRunId", "ciRunAttempt"],
      "properties": {
        "repository": {"const": "aqua-lifestyle/aqua-lifestyle"},
        "commitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "ciRunId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "ciRunAttempt": {"type": "integer", "minimum": 1}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["version", "sha256"],
      "properties": {"version": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    },
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "mandatoryChecks": {
      "type": "array", "minItems": 17, "maxItems": 17,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["context", "integrationId", "status", "conclusion", "commitSha", "ciRunId", "ciRunAttempt"],
        "properties": {
          "context": {"type": "string", "minLength": 1},
          "integrationId": {"type": "integer", "minimum": 1},
          "status": {"const": "completed"},
          "conclusion": {"const": "success"},
          "commitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "ciRunId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
          "ciRunAttempt": {"type": "integer", "minimum": 1}
        }
      }
    },
    "tests": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "file", "name", "definitionSha256", "outcome", "executions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9._:-]{1,127}$"},
          "file": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "definitionSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "outcome": {"const": "passed"},
          "executions": {"type": "integer", "minimum": 1}
        }
      }
    },
    "executionEvidenceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verdict": {"const": "PASS"}
  }
}
